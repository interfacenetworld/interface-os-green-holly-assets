{
 "name":"interface-ai-speech-engine",
 "main":"src/worker/index.ts",
 "compatibility_date":"2026-10-01",
 "workers_dev":true,
 "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application"},
 "ai":{"binding":"AI"},
 "d1_databases":[{"binding":"DB","database_name":"interface-speech-db","database_id":"REPLACE_WITH_D1_DATABASE_ID","migrations_dir":"migrations"}],
 "r2_buckets":[{"binding":"AUDIO","bucket_name":"interface-speech-audio"}],
 "vars":{"ALLOWED_ORIGIN":"http://localhost:5173","VOICE_CLONE_ENABLED":"false"}
}