{
  "name": "interface-ai-speech-engine",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply interface-speech-db --local",
    "db:remote": "wrangler d1 migrations apply interface-speech-db --remote",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "dev:token": "node scripts/dev-token.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.30.0"
  }
}
